# Copy this file to .env.local and fill in the values.

# Neon connection string (Neon dashboard > Connect). Leave it empty on your laptop
# to use the built-in local database instead (stored in ./.pglite).
DATABASE_URL=

# Secret used to sign login cookies. Make a long random value, for example with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# "on" shows the Try demo button on the login page (needs `npm run db:seed`). Set "off" for real use.
DEMO_LOGIN=on
